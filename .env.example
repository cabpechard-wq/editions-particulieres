# Copier vers .env et renseigner les valeurs.

# --- Sorties (Google Drive via Google Drive Desktop) ---
# Chemin racine synchronisé. Sous Windows (FR) : G:/Mon Drive/Editions Particulieres
EP_OUTPUT_ROOT=G:/Mon Drive/Editions Particulieres

# --- Notion API ---
NOTION_TOKEN=
NOTION_SSL_VERIFY=0

NOTION_DATABASE_ID=
NOTION_FICHES_DATABASE_ID=
NOTION_METHODO_DATABASE_ID=
NOTION_FORMULE_DATABASE_ID=
NOTION_INDEX_DATABASE_ID=
NOTION_ARRETS_DATABASE_ID=

# --- Commerce / site (secrets → wrangler secret put) ---
STRIPE_SECRET_KEY=
RESEND_API_KEY=
AUTH_SECRET=
